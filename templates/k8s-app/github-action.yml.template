name: Build and Deploy __APP_NAME__

on:
  push:
    branches:
      - main
      - develop
    paths:
      - 'apps/__APP_NAME__/**'
      - '.github/workflows/deploy-__APP_NAME__.yml'
      - 'k8s/__APP_NAME__-*.yaml'

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository_owner }}/__APP_NAME__

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      packages: write
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Log in to the Container registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Set dynamic image tags based on branch
        id: branch_tags
        run: |
          if [ "${{ github.ref }}" = "refs/heads/main" ]; then
            echo "tag=main" >> $GITHUB_OUTPUT
          elif [ "${{ github.ref }}" = "refs/heads/develop" ]; then
            echo "tag=develop" >> $GITHUB_OUTPUT
          fi

      - name: Extract version from package.json
        id: pkg_version
        run: |
          VERSION=$(node -p "require('./apps/__APP_NAME__/package.json').version")
          echo "version=v${VERSION}" >> $GITHUB_OUTPUT

      - name: Extract metadata (tags, labels) for Docker
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=raw,value=${{ steps.branch_tags.outputs.tag }}
            type=raw,value=${{ steps.pkg_version.outputs.version }}

      - name: Build and push Docker image
        id: push
        uses: docker/build-push-action@v5
        with:
          context: .
          file: apps/__APP_NAME__/Dockerfile
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}

      - name: Update Kubernetes manifests with new version tag
        run: |
          VERSION_TAG="${{ steps.pkg_version.outputs.version }}"
          if [ "${{ github.ref }}" = "refs/heads/main" ]; then
            sed -i "s|image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:.*|image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${VERSION_TAG}|" k8s/__APP_NAME__-prod.yaml
          elif [ "${{ github.ref }}" = "refs/heads/develop" ]; then
            sed -i "s|image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:.*|image: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:${VERSION_TAG}|" k8s/__APP_NAME__-staging.yaml
          fi

      - name: Commit and push manifest changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add k8s/*.yaml
          git diff --quiet && git diff --staged --quiet || (git commit -m "chore: release ${{ steps.pkg_version.outputs.version }} [skip ci]" && git push)

  trigger-deploy:
    needs: build-and-push
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Portainer Webhook (PROD)
        if: github.ref == 'refs/heads/main'
        run: |
          if [ -n "${{ secrets.PORTAINER_WEBHOOK_URL___APP_NAME_UPPER___PROD }}" ]; then
            curl -X POST "${{ secrets.PORTAINER_WEBHOOK_URL___APP_NAME_UPPER___PROD }}"
            echo "Production deployment webhook triggered!"
          else
            echo "No PROD webhook URL configured, skipping."
          fi

      - name: Trigger Portainer Webhook (STAGING)
        if: github.ref == 'refs/heads/develop'
        run: |
          if [ -n "${{ secrets.PORTAINER_WEBHOOK_URL___APP_NAME_UPPER___STAGING }}" ]; then
            curl -X POST "${{ secrets.PORTAINER_WEBHOOK_URL___APP_NAME_UPPER___STAGING }}"
            echo "Staging deployment webhook triggered!"
          else
            echo "No STAGING webhook URL configured, skipping."
          fi
