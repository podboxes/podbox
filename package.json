{
  "name": "@podbox/podbox",
  "version": "1.0.0-alpha.1",
  "description": "Monorepo for the Podbox project",
  "author": "Podbox, LLC. <code@podbox.io>",
  "license": "AGPL-3.0",
  "main": "null",
  "type": "module",
  "scripts": {
    "bootstrap": "bash ./infra/bootstrap.sh",
    "sync:secrets": "bash ./lib/scripts/sync-secrets.sh",
    "sync:secrets:dry": "bash ./lib/scripts/sync-secrets.sh --dry"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "npm-run-all": "^4.1.5",
    "nx": "20.4.2",
    "prettier": "^3.5.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poseylabs/posey.git"
  },
  "bugs": {
    "url": "https://github.com/poseylabs/posey/issues"
  },
  "homepage": "https://github.com/poseylabs/posey#readme",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "services/data",
    "services/data/*",
    "packages/*",
    "packages/plugins/*",
    "services/core",
    "services/core/*",
    "services/core/comfyui/Composey/*"
  ],
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "biome": "^0.3.3"
  }
}
